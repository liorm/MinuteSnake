{
  "name": "@minute-snake/frontend",
  "version": "1.0.0",
  "description": "MinuteSnake Game Frontend",
  "type": "module",
  "scripts": {
    "clean": "rimraf dist",
    "prebuild": "pnpm run clean",
    "build": "esbuild src/app.ts --bundle --outfile=dist/bundle.js --format=esm --platform=browser --target=es2021 --sourcemap",
    "dev": "pnpm run build -- --watch",
    "build:prod": "esbuild src/app.ts --bundle --outfile=dist/bundle.js --format=esm --platform=browser --target=es2021 --minify",
    "serve": "pnpm run build -- --watch --serve=8080 --servedir=.",
    "lint": "eslint \"src/**/*.ts\"",
    "lint:fix": "eslint \"src/**/*.ts\" --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/seedrandom": "^3.0.0",
    "@vitest/coverage-v8": "^3.2",
    "@vitest/ui": "^3.2",
    "vitest": "^3.2",
    "esbuild": "^0.25.0",
    "http-server": "^14.1.1",
    "rimraf": "^5.0.0"
  },
  "dependencies": {
    "@minute-snake/shared": "workspace:*",
    "seedrandom": "^3.0.5"
  }
}
